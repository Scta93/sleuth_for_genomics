#This for loop downloads my kallisto results into your working directory 
drive_deauth()
#folder link to id
jp_folder = "https://drive.google.com/drive/folders/12o7AxfyFF3nZiUFi7deF8rGp7OeMc37F?usp=sharing"
folder_id = drive_get(as_id(jp_folder))
#find files in folder
files = drive_ls(folder_id)
?drive_ls
#loop dirs and download files inside them
for (i in seq_along(files$name)) {
  #list files
  i_dir = drive_ls(files[i, ])
  
  #mkdir
  dir.create(files$name[i])
  
  #download files
  for (file_i in seq_along(i_dir$name)) {
    #fails if already exists
    try({
      drive_download(
        as_id(i_dir$id[file_i]),
        path = str_c(files$name[i], "/", i_dir$name[file_i])
      )
    })
  }
}

#This downloads the R environmnent then loads it 
