#This installs all the required packages -------------
if (!requireNamespace("BiocManager", quietly = TRUE))
  install.packages("BiocManager")
if (!requireNamespace("rhdf5", quietly = TRUE))
  BiocManager::install("rhdf5",ask=F)
if (!requireNamespace("devtools", quietly = TRUE))
  install.packages("devtools")
if (!requireNamespace("sleuth", quietly = TRUE))
  devtools::install_github("pachterlab/sleuth",upgrade='never')
if (!requireNamespace("fastqcr", quietly = TRUE))
  devtools::install_github("kassambara/fastqcr",upgrade='never')
if (!requireNamespace("stringr", quietly = TRUE))
  install.packages("stringr")
if (!requireNamespace("googledrive", quietly = TRUE))
  install.packages("googledrive")

#This then loads the packages
library(stringr)
library(googledrive)
library("fastqcr")
library("sleuth")

#This downloads my kallisto results (which is a tar.gz file) into your working directory 
drive_deauth()
drive_download(as_id("https://drive.google.com/file/d/1ox2E9x-baA0K0rv6TzarVWa5jGmjItTs/view?usp=sharing"), overwrite = T)

#this unzips and unpacks the tar file
untar("kallisto_genomics_2026_tar.gz")

#This downloads the R environmnent then loads it 
url<-"https://github.com/Scta93/sleuth_for_genomics/raw/refs/heads/main/R_data_2026_for_genomics_lab.RData"
download.file(url,'env.renv')
print("environment downloaded")
load(file="env.renv")
print("environment loaded")

#This is the actual script to run sleuth
s2c <- dplyr::mutate(s2c, path = kal_dirs[,2])
swt_prep<-sleuth_prep(s2c,read_bootstrap_tpm=T, ~ condition)
swt_fit<-sleuth_fit(swt_prep)
swt<-sleuth_wt(swt_fit,'conditionvenom')

#You may have to run this command again to have the window actually pop up for you 
sleuth_live(swt)
