#This is the actual script to run sleuth
s2c<-read.csv2("s2c.tsv",sep = '\t',header = T)
s2c <- dplyr::mutate(s2c, path = kal_dirs[,2])
swt_prep<-sleuth_prep(s2c,read_bootstrap_tpm=T, ~ condition)
swt_fit<-sleuth_fit(swt_prep)
swt<-sleuth_wt(swt_fit,'conditionvenom')

#You may have to run this command again to have the window actually pop up for you 
sleuth_live(swt)
